# 服务器接入（在服务器上注册设备时返回 DEVICE_TOKEN，只显示一次）
SERVER_URL=ws://127.0.0.1:8080/api/v1/robot/ws
DEVICE_ID=go2-01
DEVICE_TOKEN=

# 执行后端：mock（模拟）| go2agent（Go2Agent Skill Runtime，需 uv sync --extra go2）
ADAPTER=mock
NETWORK_INTERFACE=
DOMAIN_ID=0
ROBOT_MODEL=Unitree Go2 EDU
# 1 = 使用 Go2Agent 的 SimulatedRobotAdapter（不连 DDS，开发机验证技能映射）
GO2AGENT_SIMULATED=0
# Go2Agent 应用限速（越界会被拒绝；Controller 会先限幅到这里）
GO2_MAX_FORWARD=0.3
GO2_MAX_LATERAL=0.3
GO2_MAX_YAW=0.6
# 急停方式：damp（阻尼卸力）| stop（StopMove 保持站立）
ESTOP_MODE=damp

# 安全
WATCHDOG_MS=300
MAX_SPEED_MPS=1.5
MAX_YAW_RATE=2.0
TELEMETRY_HZ=10

# 本地 FastAPI（现场调试）；LOCAL_API_TOKEN 为空则禁用本地控制
API_HOST=0.0.0.0
API_PORT=8000
LOCAL_API_TOKEN=
