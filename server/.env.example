# 复制为 .env 后修改
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://uniconsole:uniconsole@127.0.0.1:5432/uniconsole
DB_MAX_CONNECTIONS=20

# 至少 32 字符：openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_TTL_SECS=43200

# 逗号分隔；留空 = 允许任意来源（仅开发）
CORS_ORIGINS=

ROBOT_TIMEOUT_MS=1500
TELEMETRY_HZ=10
TELEMETRY_PERSIST_MS=1000
COMMAND_TIMEOUT_MS=2000
# 任务：单个点位导航超时；排期字符串的时区（相对 UTC 的分钟数，+480 = 北京时间）
MISSION_STEP_TIMEOUT_SECS=600
SCHEDULE_TZ_OFFSET_MINUTES=480

# 邀请链接前缀（前端注册的深链）与有效期
INVITE_URL_BASE=uniconsole://invite/
INVITE_TTL_SECS=604800
API_TOKEN_TTL_DAYS=365

# WebRTC ICE 服务器（JSON 数组），留空 = 仅局域网直连
ICE_SERVERS=
# 限时 TURN 凭据（coturn use-auth-secret）：TURN_URLS 逗号分隔
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECS=43200

# 智能体服务（独立部署）；留空则 /agent/* 返回 501。AGENT_TOKEN 是双方共享密钥
AGENT_URL=
AGENT_TOKEN=

# 发信（注册验证码）。推荐本机 Postfix 经中继发出（见 deploy/mail.md）：smtp://127.0.0.1:25
# 也可直连中继：smtp://user:pass@smtp.example.com:587?tls=required。留空则邮件只写日志（仅开发）
SMTP_URL=
MAIL_FROM=UniConsole <noreply@silencecf.me>
# 是否开放邮箱自助注册（注册后仍需管理员审核）
REGISTRATION_ENABLED=true

# 数据库里没有任何成员时自动创建的管理员
BOOTSTRAP_ADMIN=kanade
BOOTSTRAP_PASSWORD=change-me-please

RUST_LOG=uniconsole_server=info,tower_http=info
