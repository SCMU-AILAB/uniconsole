# 复制为 .env 后修改
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://uniconsole:uniconsole@127.0.0.1:5432/uniconsole
DB_MAX_CONNECTIONS=20

# 至少 32 字符：openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_TTL_SECS=43200

# 逗号分隔；留空 = 允许任意来源（仅开发）
CORS_ORIGINS=

LEASE_DEFAULT_SECS=300
ROBOT_TIMEOUT_MS=1500
TELEMETRY_HZ=10
TELEMETRY_PERSIST_MS=1000
COMMAND_TIMEOUT_MS=2000

# 数据库里没有任何成员时自动创建的管理员
BOOTSTRAP_ADMIN=kanade
BOOTSTRAP_PASSWORD=change-me-please

RUST_LOG=uniconsole_server=info,tower_http=info
